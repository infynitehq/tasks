TURN_DOMAIN=turn.example.com
# Required: generate with `openssl rand -hex 32` and paste only the result below.
TURN_SHARED_SECRET=<my-shared-secret>
TURN_TLS_ENABLED=false

# Optional: host interface IPv4 override for multi-interface/NAT deployments.
# Leave empty to detect the source address from the host routing table.
TURN_RELAY_IP=
