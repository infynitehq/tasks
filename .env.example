# Optional: comma-separated public WebSocket relay URLs.
# Leave blank to use the built-in public relays until your relay is deployed.
# NEXT_PUBLIC_NOSTR_RELAY_URLS=wss://nostr.example.com
NEXT_PUBLIC_NOSTR_RELAY_URLS=

# Optional: comma-separated hostnames/IP addresses allowed to access Next dev.
# Use your laptop's LAN IP here when testing from a phone. No scheme or port.
NEXT_DEV_ALLOWED_ORIGINS=

# NEXT_PUBLIC_* values are built into browser JavaScript, not kept secret.
# Copy to .env.local; do not commit real environment files or private keys.
